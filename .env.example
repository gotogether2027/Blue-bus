# PostgreSQL (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bluebus
DB_USERNAME=bluebus
DB_PASSWORD=replace-with-a-local-secret

# Application
SERVER_PORT=8080

# Reserved for the JWT implementation phase. Use a long, high-entropy local value.
# Never commit a real value to source control.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ISSUER=blue-bus
