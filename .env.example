# =============================================================================
# LOCAL / DEMO
# Copy to `.env` and replace placeholders. Never commit `.env` or real secrets.
# Spring Boot does not load `.env` by itself — export these into the process
# environment (shell, IDE run config, or a local dotenv tool).
# =============================================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bluebus
DB_USERNAME=bluebus
DB_PASSWORD=replace-with-a-local-secret

# Application
SERVER_PORT=8080

# JWT (HS256). Local value must be at least 32 bytes. Never commit a real secret.
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_ISSUER=blue-bus
# Access-token lifetime in seconds (default 900 = 15 minutes).
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Opaque refresh-token lifetime in seconds (default 1209600 = 14 days).
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_TOKEN_CONCURRENT_REUSE_GRACE_SECONDS=5

# Payments — local/test may remain UNCONFIGURED (checkout then returns HTTP 503).
PAYMENT_PROVIDER=UNCONFIGURED
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_BASE_URL=https://api.razorpay.com

# Local demo catalog for browser E2E. Leave false unless you intend to seed
# known demo customer/operator-admin accounts. Do not enable with profile `prod`.
DEMO_DATA_ENABLED=false
DEMO_CUSTOMER_EMAIL=demo.customer@example.test
# Required when DEMO_DATA_ENABLED=true. 8–72 chars, letter + digit. Do not commit a real password.
DEMO_CUSTOMER_PASSWORD=

# CORS — local Angular uses the customer-web `/api` proxy, so CORS is unused.
# Fail-closed default is an empty allow-list (same-origin). Never use "*".
BLUE_BUS_CORS_REQUIRE_ALLOWED_ORIGINS=false
# BLUE_BUS_CORS_ALLOWED_ORIGINS_0=http://localhost:4200

# Core business API registration (historical name: admin-master-data).
# Leave true. Tests may disable it together with outbox processing.
BLUE_BUS_ADMIN_MASTER_DATA_ENABLED=true

# =============================================================================
# PRODUCTION
# Activate fail-fast validation with SPRING_PROFILES_ACTIVE=prod
# Primary deployment: serve the Angular SPA and Spring Boot `/api/v1` on the
# same public origin. customer-web production uses relative `/api/v1`.
# =============================================================================

# SPRING_PROFILES_ACTIVE=prod
# DEMO_DATA_ENABLED=false
# BLUE_BUS_ADMIN_MASTER_DATA_ENABLED=true
# PAYMENT_PROVIDER=RAZORPAY
# RAZORPAY_KEY_ID=replace-with-production-key-id
# RAZORPAY_KEY_SECRET=replace-with-production-key-secret
# RAZORPAY_WEBHOOK_SECRET=replace-with-production-webhook-secret
# DB_HOST=replace-with-production-db-host
# DB_PORT=5432
# DB_NAME=bluebus
# DB_USERNAME=replace-with-production-db-user
# DB_PASSWORD=replace-with-production-db-password
# JWT_SECRET=replace-with-a-long-random-production-secret
# JWT_ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
# Same-origin (recommended): leave CORS allow-list empty and require-allowed-origins=false.
# Split-origin only — set at least one explicit origin (never "*") and:
# BLUE_BUS_CORS_REQUIRE_ALLOWED_ORIGINS=true
# BLUE_BUS_CORS_ALLOWED_ORIGINS_0=https://tickets.example.com
